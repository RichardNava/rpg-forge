{
  "name": "rules-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:workerd": "vitest run --config vitest.workerd.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types --env-interface Env ./cloudflare-env.d.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@repo/rules-analysis-session": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260811.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "typescript": "^5.7.4",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
