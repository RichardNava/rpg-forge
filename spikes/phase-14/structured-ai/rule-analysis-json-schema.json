{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "characterIntent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": ["summary"]
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleOverrides": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": ["key", "value"]
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": ["key", "summary", "page"]
      }
    }
  },
  "required": ["characterIntent", "ruleOverrides", "rules"]
}
